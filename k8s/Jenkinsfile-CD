pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        DOCKER_CREDS = credentials('docker-hub-credentials')
    }

    stages {

        stage('1 — Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('2 — Checkout') {
            steps {
                checkout scm
                echo 'K8s manifests retrieved from SCM'
            }
        }

        stage('3 — Verify Images on DockerHub') {
            steps {
                sh "docker pull selmianas/formation:latest"
                sh "docker pull selmianas/event:latest"
                echo 'All images verified on DockerHub'
            }
        }

        stage('4 — Apply Namespace and Secrets') {
            steps {
                sh 'kubectl apply -f k8s/namespace.yaml'
                sh 'kubectl apply -f k8s/secrets/'
                echo 'Namespace and secrets applied'
            }
        }

        stage('5 — Deploy Microservices') {
            steps {
                sh 'kubectl apply -f k8s/deployments/'
                echo 'Deployments applied'
            }
        }

        stage('6 — Wait for Pods Ready') {
            steps {
                sh 'kubectl rollout status deployment/formation -n pidev --timeout=120s'
                sh 'kubectl rollout status deployment/event -n pidev --timeout=120s'
                echo 'All pods are running'
            }
        }

        stage('7 — Deploy Monitoring') {
            steps {
                sh 'kubectl apply -f k8s/monitoring/'
                echo 'Prometheus and Grafana deployed'
            }
        }

        stage('8 — Health Check') {
            steps {
                sh 'kubectl get pods -n pidev -o wide'
                sh 'kubectl get services -n pidev'
                echo 'Formation accessible at: http://localhost:30081/actuator/health'
                echo 'Event accessible at: http://localhost:30082/actuator/health'
                echo 'Prometheus at: http://localhost:30090'
                echo 'Grafana at: http://localhost:30300'
            }
        }
    }

    post {
        success {
            echo 'CD Pipeline SUCCESS — all services deployed on Kubernetes'
        }
        failure {
            sh 'kubectl get events -n pidev --sort-by=.metadata.creationTimestamp | tail -20'
            echo 'Check K8s events above to diagnose the failure'
        }
    }
}

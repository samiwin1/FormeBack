pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME   = 'samiwin/certification-service'
        IMAGE_TAG    = 'latest'
        DOCKER_CREDS = credentials('dockerhub-credentials')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [
                        [$class: 'CloneOption', shallow: true, depth: 1, noTags: true, timeout: 20]
                    ]
                ])
            }
        }

        stage('Build') {
            steps {
                dir('certification-service') {
                    bat 'mvn clean package -DskipTests -B'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('certification-service') {
                    bat 'mvn test -B'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('certification-service') {
                    bat "docker build -t %IMAGE_NAME%:%IMAGE_TAG% ."
                }
            }
        }

        stage('Docker Push') {
            steps {
                bat "docker login -u %DOCKER_CREDS_USR% -p %DOCKER_CREDS_PSW%"
                bat "docker push %IMAGE_NAME%:%IMAGE_TAG%"
            }
        }

    }

    post {
        always {
            node('') {
                bat "docker rmi %IMAGE_NAME%:%IMAGE_TAG% || exit 0"
            }
        }
        success {
            echo 'CI Pipeline succeeded - image pushed to Docker Hub.'
        }
        failure {
            echo 'CI Pipeline failed - check logs above.'
        }
    }
}
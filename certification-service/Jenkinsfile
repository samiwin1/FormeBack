pipeline {
    agent any

    environment {
        IMAGE_NAME = 'pidev/certification-service:latest'
        SONAR_PROJECT_KEY = 'certification-service'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('certification-service') {
                    bat 'mvn clean package -DskipTests -B'
                }
            }
        }

        stage('Tests & Coverage') {
            steps {
                dir('certification-service') {
                    bat 'mvn test jacoco:report -B'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'certification-service/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        dir('certification-service') {
                            bat "mvn sonar:sonar -B -Dsonar.projectKey=%SONAR_PROJECT_KEY% -Dsonar.login=%SONAR_TOKEN%"
                        }
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('certification-service') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        bat "docker build -t %IMAGE_NAME% ."
                        bat "echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin"
                        bat "docker push %IMAGE_NAME%"
                        bat "docker logout"
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'certification-service CI pipeline completed successfully.'
        }
        failure {
            echo 'certification-service CI pipeline failed.'
        }
    }
}

pipeline {
    agent any

    stages {

        stage('Checkout Manifests') {
            steps {
                echo 'K8s manifests checked out by Jenkins SCM'
            }
        }

        stage('Deploy MySQL') {
            steps {
                bat 'kubectl apply -f k8s\\mysql-deployment.yaml'
            }
        }

        stage('Deploy certification-service') {
            steps {
                bat 'kubectl apply -f k8s\\certification-secret.yaml'
                bat 'kubectl apply -f k8s\\certification-deployment.yaml'
                bat 'kubectl apply -f k8s\\certification-service-svc.yaml'
            }
        }

        stage('Rollout Status') {
            steps {
                bat 'kubectl rollout status deployment/certification-service -n devops --timeout=120s'
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'kubectl get pods -n devops'
                bat 'kubectl get svc -n devops'
            }
        }

    }

    post {
        success {
            echo 'Deployment to Kubernetes succeeded!'
        }
        failure {
            bat 'kubectl get events -n devops --sort-by=.metadata.creationTimestamp'
        }
    }
}

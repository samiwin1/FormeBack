pipeline {
    agent any

    environment {
        KUBECONFIG = 'C:\\Users\\dhafe\\.kube\\config'
        K8S_DIR    = 'certification-service\\k8s'
    }

    stages {

        stage('Checkout Manifests') {
            steps {
                echo 'K8s manifests checked out by Jenkins SCM'
            }
        }

        stage('Deploy MySQL') {
            steps {
                bat "kubectl apply -f %K8S_DIR%\\mysql-deployment.yaml -n devops"
            }
        }

        stage('Deploy certification-service') {
            steps {
                bat "kubectl apply -f %K8S_DIR%\\certification-deployment.yaml -n devops"
                bat "kubectl apply -f %K8S_DIR%\\certification-service-svc.yaml -n devops"
            }
        }

        stage('Rollout Status') {
            steps {
                bat 'kubectl rollout status deployment/certification-service -n devops --timeout=180s'
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'kubectl get pods -n devops'
                bat 'kubectl get svc -n devops'
            }
        }

    }

    post {
        success {
            echo 'Deployment to Kubernetes succeeded!'
        }
        failure {
            bat 'kubectl get events -n devops --sort-by=.metadata.creationTimestamp'
        }
    }
}
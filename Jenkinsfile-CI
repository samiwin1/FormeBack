// CI Pipeline — mentor-service
// Stages: Checkout → Test+Coverage → SonarQube → Quality Gate → Docker Build
pipeline {
    agent any

    environment {
        IMAGE_NAME = "YOUR_DOCKERHUB_USERNAME/mentor:latest"
    }

    tools {
        maven 'Maven'
        jdk   'JDK17'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Unit Tests + JaCoCo Coverage') {
            steps {
                // pom.xml is at root — build directly from here.
                sh 'mvn verify jacoco:report -B'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                        mvn sonar:sonar -B \\
                          -Dsonar.projectKey=mentor \\
                          -Dsonar.projectName=mentor \\
                          -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                // Dockerfile is at repo root alongside pom.xml.
                sh "docker build -t ${IMAGE_NAME} ."
            }
        }
    }

    post {
        failure { echo 'CI pipeline failed.' }
        success { echo 'CI pipeline passed — image built and ready for CD.' }
    }
}
